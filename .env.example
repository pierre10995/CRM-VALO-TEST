# ── Base de données (OBLIGATOIRE) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_valo
# Vérification stricte du certificat TLS en production (recommandé)
# DB_SSL_STRICT=true
# DB_CA_CERT="-----BEGIN CERTIFICATE-----..."
# PG_POOL_MAX=10

# ── Serveur ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT (OBLIGATOIRE en production) ─────────────────────────────────
# JWT_SECRET=change-me-in-production

# ── CORS ────────────────────────────────────────────────────────────
# Séparés par des virgules. Défaut en dev : localhost:5173,localhost:3000
# ALLOWED_ORIGINS=https://votre-app.up.railway.app

# ── Supabase Auth (OBLIGATOIRE) ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── IA (import CV, matching, évaluation, résumé) ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Emails (reset mot de passe, notifications partenaires) ──────────
# RESEND_API_KEY=re_...
# ADMIN_EMAIL=admin@example.com

# ── Seed ────────────────────────────────────────────────────────────
# Mots de passe initiaux des comptes fondateurs (OBLIGATOIRES en production
# lors du tout premier démarrage sur une base vide).
# SEED_PWD_OCEANE=
# SEED_PWD_PIERRE=
# Données de démonstration (contacts/missions fictifs) : jamais en prod
# sauf si explicitement demandé.
# SEED_DEMO_DATA=false
